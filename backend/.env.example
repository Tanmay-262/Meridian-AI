# App Environment
ENV=development

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@db:5432/meridian

# Redis Settings
REDIS_URL=redis://redis:6379/0

# Qdrant Settings
QDRANT_URL=http://qdrant:6333

# JWT Authentication Settings
# You can generate a random secret key using: openssl rand -hex 32
JWT_SECRET_KEY=supersecretkeyreplaceinproduction12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Fill in as needed)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
